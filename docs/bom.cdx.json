  "components": [
    {
      "type": "machine-learning-model",
      "bom-ref": "model:bedrock/amazon.nova-2-lite-v1:0",
      "name": "Amazon Nova 2 Lite",
      "version": "amazon.nova-2-lite-v1:0",
      "group": "amazon",
      "description": "Default LLM used for AI-augmented per-control risk narratives, executive summaries, and advisory status/risk suggestions. Accessed as a hosted inference service via Amazon Bedrock; no training or fine-tuning is performed by this project.",
      "publisher": "Amazon Web Services",
      "supplier": { "name": "Amazon Web Services" },
      "externalReferences": [
        {
          "type": "website",
          "url": "https://aws.amazon.com/bedrock/"
        }
      ],
      "modelCard": {
        "modelParameters": {
          "approach": { "type": "supervised" },
          "task": "text-generation"
        },
        "considerations": {
          "useCases": [
            "Generate human-readable risk narratives for individual NIST 800-53 control findings.",
            "Produce an executive summary across the assessment.",
            "Provide advisory suggested status / risk with a confidence score and explanation."
          ],
          "technicalLimitations": [
            "Outputs are advisory only; deterministic evidence checks remain authoritative.",
            "Auto-apply of suggestions is OFF by default and gated by a configurable confidence threshold (default 0.9).",
            "When a suggestion is auto-applied, original status and risk level are preserved for auditability.",
            "Hosted external inference: control evidence is sent to AWS Bedrock when narrative generation is enabled."
          ]
        }
      },
      "properties": [
        { "name": "bobbie:provider", "value": "bedrock" },
        { "name": "bobbie:role", "value": "advisory-narrative-and-suggestion" },
        { "name": "bobbie:default-model", "value": "true" },
        { "name": "bobbie:hosting", "value": "external-hosted-inference" },
        { "name": "bobbie:default-temperature", "value": "0.0" },
        { "name": "bobbie:default-max-tokens", "value": "4096" },
        { "name": "bobbie:enabled-by", "value": "--nova-narrative / nova_narrative context flag" }
      ]
    },
    {
      "type": "machine-learning-model",
      "bom-ref": "model:openai/gpt-4o",
      "name": "GPT-4o",
      "version": "gpt-4o",
      "group": "openai",
      "description": "Default model when the OpenAI-compatible provider is selected. Any OpenAI-compatible endpoint may be substituted via LLM_BASE_URL (e.g. Azure OpenAI, Ollama, vLLM, LM Studio), so the concrete model is deployment-dependent.",
      "publisher": "OpenAI",
      "supplier": { "name": "OpenAI (or operator-configured OpenAI-compatible endpoint)" },
      "externalReferences": [
        {
          "type": "website",
          "url": "https://platform.openai.com/docs/models"
        }
      ],
      "modelCard": {
        "modelParameters": {
          "approach": { "type": "supervised" },
          "task": "text-generation"
        },
        "considerations": {
          "useCases": [
            "Same advisory narrative/summary/suggestion role as the Bedrock default, when the OpenAI provider is selected."
          ],
          "technicalLimitations": [
            "Concrete model and hosting depend on operator configuration (LLM_MODEL_ID / LLM_BASE_URL).",
            "When pointed at a local OpenAI-compatible endpoint, inference may run fully offline; when pointed at OpenAI, evidence is sent to OpenAI.",
            "Advisory only; same confidence-gating and auditability safeguards apply."
          ]
        }
      },
      "properties": [
        { "name": "bobbie:provider", "value": "openai" },
        { "name": "bobbie:role", "value": "advisory-narrative-and-suggestion" },
        { "name": "bobbie:default-model", "value": "false" },
        { "name": "bobbie:hosting", "value": "external-or-local-openai-compatible" },
        { "name": "bobbie:configurable-via", "value": "LLM_MODEL_ID, LLM_BASE_URL, LLM_API_KEY" }
      ]
    },

