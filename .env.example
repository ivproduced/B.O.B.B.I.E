# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: bedrock (default) | openai
LLM_PROVIDER=bedrock

# Model identifier (provider-specific defaults are used when unset)
#   bedrock default: amazon.nova-2-lite-v1:0
#   openai  default: gpt-4o
LLM_MODEL_ID=

# Generation parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── OpenAI / OpenAI-compatible endpoint ──────────────────────────────────────
# Required when LLM_PROVIDER=openai
LLM_API_KEY=
# Override base URL to point at any OpenAI-compatible API (Ollama, Azure OpenAI,
# vLLM, LM Studio, Anthropic via proxy, etc.)
# Example: http://localhost:11434/v1  (Ollama)
#          https://<resource>.openai.azure.com/  (Azure OpenAI)
LLM_BASE_URL=

# ── AWS / Bedrock ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default
# Optional: only needed if using temporary Bedrock credentials
# export AWS_BEARER_TOKEN_BEDROCK=your_token_here
